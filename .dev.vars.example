# Скопіюйте в .dev.vars (в git не потрапляє). У проді те саме через `wrangler secret put`.
# Від 32 символів: `openssl rand -base64 48`
AUTH_SECRET=
# Без ключа локально вхід працює з кодом 000000, лист не надсилається.
RESEND_API_KEY=
MAIL_FROM=Findlyfy <hello@findlyfy.com>
# Тестовий вхід без пошти: код доступу, 4–8 цифр. Без нього локально працює 000000.
DEV_LOGIN_CODE=
# Google OAuth; кнопку показуємо, лише коли обидва заповнені.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Telegram-бот (lib/telegram). Токен від @BotFather, не в чат і не в git. Без токена й секрету бот вимкнений.
TELEGRAM_BOT_TOKEN=
# openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_USERNAME=
# Публічний канал запитів: id каналу (-100…) з'явиться в журналі, коли додасте бота адміном.
TELEGRAM_CHANNEL_ID=
CHANNEL_ENABLED=
CHANNEL_DELAY_MIN=20
# openssl rand -hex 32: захищає /api/internal/tick, який викликає cron воркера. Обов'язковий: без нього (і без SITE_URL)
# cron нічого не робить, воркер лише пише tick_not_configured у журнал. На dev і проді: `wrangler secret put INTERNAL_TOKEN --env ...`.
INTERNAL_TOKEN=

# Токен еквайрингу Monobank: термінал без розщеплення, оплата розміщення на карті; безпечна угода піде тим самим вебхуком.
# На dev тестовий токен з https://api.monobank.ua/ (гроші не рухаються).
# На проді: бойовий з кабінету web.monobank.ua, `wrangler secret put MONOBANK_TOKEN --env production`.
MONOBANK_TOKEN=

# Термінал розщеплення Monobank для безпечної угоди (окремий токен; вебхук підписують ключі обох терміналів).
MONOBANK_SPLIT_TOKEN=
# splitReceiverId нашого ФОП у розщепленні (отримує комісію платформи): береться з GET /api/merchant/split-receiver/list.
MONOBANK_PLATFORM_RECEIVER_ID=
# Безпечна угода: off (типово) | allowlist | on. Для allowlist: SAFE_DEAL_USERS, пошти через кому.
# Оплати й нові угоди питають режим; гроші, що вже в русі (вебхук, звірка, виплата), його не питають.
SAFE_DEAL_MODE=off
SAFE_DEAL_USERS=

# Прапорці функцій (off | allowlist | on, пошти через кому). Значення, збережене в адмінці (/admin/features), важливіше за ці.
# Без обох функція вимкнена. Зміна грошових і крипто-прапорців в адмінці потребує коду TOTP.
CRYPTO_PROOF_MODE=off
CRYPTO_PROOF_USERS=
CRYPTO_WALLET_MODE=off
CRYPTO_WALLET_USERS=
CRYPTO_ESCROW_MODE=off
CRYPTO_ESCROW_USERS=
# QR переказу за форматом НБУ: показувати, лише коли сканування перевірено в банках. Локально можна `on`.
NBU_QR_MODE=off
NBU_QR_USERS=
# PayPal і Wise у реквізитах (off | allowlist | on). Умови сервісів для України не перевірено: не вмикати без юриста.
FOREIGN_LINKS_MODE=off
FOREIGN_LINKS_USERS=

# Ключ TronGrid (необов'язковий): підвищує ліміт запитів при перевірці USDT TRC-20 за хешем. Секрет.
TRONGRID_API_KEY=

# Ключ шифрування реквізитів виконавців (AES-256-GCM): `openssl rand -base64 32`. Без нього реквізити не зберігаються.
# На dev і проді: `wrangler secret put REQUISITES_KEY --env development|production`. Не міняти без перешифрування.
REQUISITES_KEY=

# UAPAY (sandbox): id клієнта й тестовий secret key магазину з кабінету account.uapay.ua. Лише для scripts/uapay-probe.ts.
UAPAY_CLIENT_ID=
UAPAY_SECRET=

# Пошти адміністраторів через кому: доступ до /admin і /api/admin (розбір спорів). Без значення адмінки немає.
# На dev і проді: `wrangler secret put ADMIN_EMAILS --env development|production`. Вхід як адмін: лише через Google або
# пошту з реальним листом; де код входу відомий усім (000000), пошта не доказ.
ADMIN_EMAILS=
# Хости, з яких видно адмінку, через кому (прихований піддомен). Задано: на решті хостів, зокрема основному, 404.
# Не задано: на проді адмінки немає, локально й на dev без обмеження.
ADMIN_HOSTS=
# Лише локально: пускати в адмінку і після тестового входу (код 000000).
ADMIN_DEV_LOGIN=

# Другий фактор для грошових рішень модератора (виплата, повернення, часткова виплата): секрет TOTP у base32,
# наприклад `openssl rand 20 | base32`, і додати в застосунок-автентифікатор. На проді без нього ці рішення недоступні.
# `wrangler secret put ADMIN_TOTP_SECRET --env development|production`.
ADMIN_TOTP_SECRET=

# Оплати USDT з гаманця (EVM), прапорці crypto_wallet і crypto_escrow. Немає потрібної адреси: функція вимкнена, хоч би що стояло в прапорці.
# Мережа: 42161 (Arbitrum One), 137 (Polygon), 31337 (локальний Hardhat) тощо.
CRYPTO_CHAIN_ID=
# АДРЕСУ ТОКЕНА НЕ БРАТИ З ПАМ'ЯТІ: звірити зі сторінкою Tether (tether.to/en/supported-protocols) для обраної мережі. Це заглушка.
CRYPTO_TOKEN_ADDRESS=0x0000000000000000000000000000000000000a11
# FeeRouter: є, тоді прямий платіж іде через нього з комісією; порожньо: звичайний transfer без комісії.
CRYPTO_ROUTER_ADDRESS=
# EscrowFactory: без неї ескроу вимкнено.
CRYPTO_FACTORY_ADDRESS=
# RPC для перевірки транзакцій на сервері (https; http лише для localhost). Може містити ключ провайдера: секрет, у браузер не віддається.
CRYPTO_RPC_URL=
# Стеля угоди ескроу, USDT (ціле); порожньо: 1000. Не вище ліміту фабрики. Значення для dev і прода задані в wrangler.jsonc
# (dev 1000, prod 10000); тут лише для локальної перевірки. Підняти прод вище 10000 можна тільки після аудита.
CRYPTO_MAX_DEAL_USDT=
# Project ID із Reown (WalletConnect), публічний, у збірку: прив'язати до своїх доменів. Без нього WalletConnect у списку немає.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
