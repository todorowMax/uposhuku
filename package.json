{
  "name": "uposhuku",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/copy-maplibre-worker.mjs",
    "dev": "next dev -p ${PORT:-3031}",
    "prebuild": "node scripts/copy-maplibre-worker.mjs",
    "build": "next build",
    "start": "next start -p ${PORT:-3031}",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint . && stylelint \"**/*.css\"",
    "lint:ci": "eslint . --max-warnings 852 && stylelint \"**/*.css\" --max-warnings 11",
    "deadcode": "knip --include files,dependencies,unlisted,unresolved",
    "test": "npm run test:unit",
    "test:unit": "vitest run --config vitest.config.mts tests/unit",
    "test:unit:watch": "vitest --config vitest.config.mts tests/unit",
    "clean:build": "rm -rf .next .open-next tsconfig.tsbuildinfo",
    "precf:build": "node scripts/copy-maplibre-worker.mjs",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare preview --env development",
    "cf:deploy:development": "opennextjs-cloudflare deploy --env development",
    "cf:deploy:production": "opennextjs-cloudflare deploy --env production",
    "map:textures": "tsx scripts/build-textures.ts",
    "map:assets": "tsx scripts/build-maplibre-assets.ts",
    "map:space": "tsx scripts/build-space.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local --env development",
    "db:migrate:development": "wrangler d1 migrations apply DB --remote --env development",
    "db:migrate:production": "wrangler d1 migrations apply DB --remote --env production",
    "map:faces": "tsx scripts/build-faces.ts",
    "db:backfill-tags:local": "tsx scripts/backfill-tag-sources.ts",
    "db:backfill-tags:development": "tsx scripts/backfill-tag-sources.ts --remote",
    "db:telemetry:migrate:local": "wrangler d1 migrations apply TELEMETRY_DB --local --env development",
    "db:telemetry:migrate:development": "wrangler d1 migrations apply TELEMETRY_DB --remote --env development",
    "db:telemetry:migrate:production": "wrangler d1 migrations apply TELEMETRY_DB --remote --env production",
    "kit:pull": "git subtree pull --prefix=kit web-kit main -m \"kit: оновлення з web-kit\"",
    "kit:push": "git subtree push --prefix=kit web-kit main",
    "tel": "tsx scripts/telemetry.ts",
    "tags:resolve": "tsx scripts/tags-resolve.ts",
    "tg:setup": "tsx scripts/telegram-setup.ts",
    "mono:probe": "tsx scripts/mono-split-probe.ts",
    "db:seed:local": "tsx scripts/seed-dev.ts && wrangler d1 execute DB --local --env development --file .cache/seed.sql",
    "db:seed:development": "tsx scripts/seed-dev.ts && wrangler d1 execute DB --remote --env development --file .cache/seed.sql",
    "db:unseed:local": "tsx scripts/seed-dev.ts --clean && wrangler d1 execute DB --local --env development --file .cache/seed.sql",
    "db:unseed:development": "tsx scripts/seed-dev.ts --clean && wrangler d1 execute DB --remote --env development --file .cache/seed.sql"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.6",
    "@tailwindcss/postcss": "^4.3.3",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "drizzle-orm": "^0.45.3",
    "gsap": "^3.15.0",
    "heic-to": "^1.6.5",
    "jose": "^6.2.12",
    "lucide-react": "^1.48.0",
    "maplibre-gl": "6.11.2",
    "motion": "^14.0.0",
    "next": "^15.5.26",
    "postcss": "^8.5.28",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260928.1",
    "@napi-rs/canvas": "^1.0.9",
    "@next/eslint-plugin-next": "^15.5.28",
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-plugin-check-file": "^3.3.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-sonarjs": "^4.2.2",
    "knip": "^6.42.1",
    "lefthook": "^2.2.2",
    "stylelint": "^17.16.0",
    "tsx": "^4.23.15",
    "typescript-eslint": "^8.72.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.143.0"
  }
}
